# Server Configuration
PORT=3000

# API Key to protect your server (optional but recommended)
SERVER_API_KEY=your-random-api-key-here

# AI Provider: anthropic, openai, or gemini
AI_PROVIDER=anthropic

# AI Model (optional - uses default if not specified)
# For Anthropic: claude-sonnet-4-20250514, claude-3-5-haiku-20241022, etc.
# For OpenAI: gpt-4o, gpt-4o-mini, etc.
# For Gemini: gemini-1.5-flash, gemini-1.5-pro, etc.
AI_MODEL=

# API Keys (set the one for your chosen provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
